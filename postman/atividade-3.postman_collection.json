{
  "info": {
    "name": "AppBooking - Atividade 3",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{adminToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "adminToken",
      "value": "admin-local-123"
    }
  ],
  "item": [
    {
      "name": "01 - Saúde do gateway",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 - Cadastrar quarto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quartos",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Quarto 101\",\n  \"fechaduraId\": \"FECH-{{sufixo}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"sufixo\", pm.variables.replaceIn(\"{{$guid}}\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"quartoId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "03 - Cadastrar hóspede",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pessoas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Ana Silva\",\n  \"email\": \"ana-{{sufixo}}@exemplo.com\",\n  \"tipo\": \"hospede\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"pessoaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 - Cadastrar senha válida agora",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/senhas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quartoId\": \"{{quartoId}}\",\n  \"pessoaId\": \"{{pessoaId}}\",\n  \"senha\": \"012345\",\n  \"inicio\": \"{{inicio}}\",\n  \"fim\": \"{{fim}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"inicio\", new Date(Date.now()-60000).toISOString());",
              "pm.collectionVariables.set(\"fim\", new Date(Date.now()+3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"senhaId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "05 - Acesso permitido",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/acessos",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fechaduraId\": \"FECH-{{sufixo}}\",\n  \"senha\": \"012345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Abre a porta\", () => pm.expect(pm.response.json().autorizado).to.eql(true));"
            ]
          }
        }
      ]
    },
    {
      "name": "06 - Senha incorreta",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/acessos",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fechaduraId\": \"FECH-{{sufixo}}\",\n  \"senha\": \"999999\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Nega entrada\", () => pm.expect(pm.response.json().autorizado).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "07 - Cadastrar senha vencida",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/senhas",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quartoId\": \"{{quartoId}}\",\n  \"pessoaId\": \"{{pessoaId}}\",\n  \"senha\": \"654321\",\n  \"inicio\": \"{{inicioVencido}}\",\n  \"fim\": \"{{fimVencido}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"inicioVencido\", new Date(Date.now()-7200000).toISOString());",
              "pm.collectionVariables.set(\"fimVencido\", new Date(Date.now()-3600000).toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    },
    {
      "name": "08 - Senha vencida não abre",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/acessos",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fechaduraId\": \"FECH-{{sufixo}}\",\n  \"senha\": \"654321\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Fora da validade\", () => pm.expect(pm.response.json().motivo).to.eql(\"fora_da_validade\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "09 - Histórico do quarto",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/acessos?quartoId={{quartoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Registra permitidas e negadas\", () => { const dados = pm.response.json(); pm.expect(dados.some(a => a.autorizado)).to.eql(true); pm.expect(dados.some(a => !a.autorizado)).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 - Consultar metadados das senhas",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/senhas"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Não expõe códigos\", () => pm.response.json().forEach(s => { pm.expect(s).not.to.have.property(\"senha\"); pm.expect(s).not.to.have.property(\"hash\"); }));"
            ]
          }
        }
      ]
    },
    {
      "name": "11 - Revogar senha válida",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/senhas/{{senhaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "12 - Senha revogada não abre",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/acessos",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fechaduraId\": \"FECH-{{sufixo}}\",\n  \"senha\": \"012345\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Revogação impede entrada\", () => pm.expect(pm.response.json().autorizado).to.eql(false));"
            ]
          }
        }
      ]
    },
    {
      "name": "13 - Desativar pessoa",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/pessoas/{{pessoaId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "14 - Desativar quarto",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quartos/{{quartoId}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));"
            ]
          }
        }
      ]
    },
    {
      "name": "15 - Consulta sem administrador",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/quartos",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    }
  ]
}
